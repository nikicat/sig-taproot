{
  "name": "sig-taproot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bitcoin taproot wallet deterministically derived from an EVM wallet signature (client-side demo)",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "bundle": "esbuild src/app.js --bundle --format=esm --outfile=dist/app.bundle.js",
    "test": "node --test",
    "test:e2e": "playwright test --project=mock",
    "test:e2e:ambire": "playwright test --project=ambire",
    "serve": "python -m http.server 8000"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@scure/base": "2.2.0",
    "@scure/bip32": "2.2.0",
    "@scure/bip39": "2.2.0",
    "@scure/btc-signer": "2.2.0",
    "viem": "2.55.8"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "esbuild": "0.28.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
